<%- include('parts/header.ejs') %>

<br>
<br>

<form style="width: 30%;    margin-left: auto;margin-right: auto;" action="/collections/editcar " method="get" enctype="multipart/form-data">
    <div class="form-group">
    <label class="form-label" for="marque">Marque</label>
    <input class="form-input" type="text" name="marque" value="<%= findcar.marque %>">
    </div>
    <div class="form-group">
    <label class="form-label" for="modele">Modele</label>
    <input class="form-input" type="text" name="modele" value="<%= findcar.modele %>">
    </div>
    <div class="form-group">
    <label class="form-label" for="price">Price</label>
    <input class="form-input" type="number" name="number" value="<%= findcar.price %>">
    </div>
    <div class="form-group">
    <label class="form-label" for="color">Color</label>
    <input class="form-input" type="text" name="color" value="<%= findcar.color %>">
    </div>
    <div class="form-group">
    <label class="form-label" for="annee">Annee</label>
    <input class="form-input" type="number" name="number" value="<%= findcar.annee %>">
    </div>
    <div class="form-group">
    <label class="form-label" for="moteur">Moteur</label>
    <input class="form-input" type="text" name="moteur" value="<%= findcar.moteur %>">
    </div>
    <div class="form-group">
    <label class="form-label" for="consommation">Consommation</label>
    <input class="form-input" type="text" name="consommation" value="<%= findcar.consommation %>">
    </div>
    <div class="form-group">
    <label class="form-label" for="performance">Performance</label>
    <input class="form-input" type="text" name="performance" value="<%= findcar.performance %>">
    </div>
    <div class="form-group">
    <label class="form-label" for="description">Description</label> 
    <input class="form-input" type="text" name="description" value="<%= findcar.description %>">
    </div>
    <div class="form-group">
    <label class="form-label" for="image">Image</label>
    <input class="form-input" type="file" name="image" value="<%= findcar.image %>">
    </div>
    <button type="submit" class="btn btn-primary"style="margin-left: 75px;">EDIT</button>
    </div>




















</form>
















