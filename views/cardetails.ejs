<%- include('parts/header.ejs') %>
   <!-- car details -->
    <section class="craftsmanship" id="craftsmanship">
        <div class="container">
            <div class="craft-grid">
                <div class="craft-content">
                    <p class="text-label">L'élégance qui roule avec puissance.</p>
                    <br>
                    <br>
                    <h2 class="heading-display craft-title">
                        L'élégance en mouvement.
                    </h2>
                    
                    <p class="text-body craft-text">
                      <%= details.description %>
                    </p>
                    <ul class="craft-list text-body">
                        
                        <li><%= details.annee %></li>
                        <li><%= details.color %></li>
                    <li><%= details.price %>Dt</li>
                    </ul>
                   
                    <a href="/contact" class="btn-primary">Commission a Custom Piece</a>
                </div>
                <div class="craft-image-wrapper">
                    <div class="craft-image">
                        <img src="/image/<%= details.image %>" 
                             alt="">
                    </div>
                    <div class="craft-stats">
                        <div class="stat-item">
                            <p class="stat-number">Moteur</p>
                            <p class="stat-label">4 cylindres 2.0 L Turbo</p>
                        </div>
                        <div class="stat-item">
                            <p class="stat-number">Performance</p>
                            <p class="stat-label">201 à 254 chevaux </p>
                        </div>
                        <div class="stat-item">
                            <p class="stat-number">Consommation</p>
                            <p class="stat-label">6.9 L/100 Km</p>
                        </div>
                      
                    </div>
                </div>
            </div>
        </div>
    </section>
  <%- include('parts/footer.ejs') %>