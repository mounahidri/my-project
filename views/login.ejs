<form style="width: 30%;margin-left: auto;margin-right: auto;" action="/login" method="POST">

   <div class="form-group">
    <label class="form-label" for="email">Email Address</label>
    <input type="email" id="email" name="email" class="form-input" placeholder="Enter email" required>
    
  </div>
  <div class="form-group">
    <label class="form-label" for="password">Password</label>
    <input type="password" id="password" name="password" class="form-input" placeholder="Password" required> 
  </div>
  
  <button type="submit" class="btn btn-primary"style="margin-left: 75px;">Login</button>
  <% if(error.length > 0) {  %>

    <p style="color: red; text-align: center;"><%= error %></p>

 <% } %>
</form>
